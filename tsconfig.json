{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "out",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "types": ["node"],
    // `paths` is resolved relative to this tsconfig's directory (no `baseUrl`
    // needed since TS 5.0). `baseUrl` was removed because it's deprecated in
    // TS 6.0 and stops functioning in 7.0 — keeping `paths` alone is the
    // forward-compatible form.
    "paths": {
      "@modelcontextprotocol/sdk/*": [
        "./node_modules/@modelcontextprotocol/sdk/dist/cjs/*"
      ]
    }
  },
  "include": ["shared/**/*.ts"],
  "exclude": ["node_modules", "out", ".vscode-test"]
}
