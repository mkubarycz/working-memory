{
  "name": "working-memory-desktop",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node ../scripts/prepare-desktop-runtime.mjs && node ../scripts/install-desktop-app.mjs",
    "start": "npm run build && electron out/main/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.7.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "jsqr": "^1.4.0",
    "markdown-it": "^15.0.1",
    "svelte": "^5.19.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.15.0",
    "electron": "^37.2.0",
    "electron-vite": "^4.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
