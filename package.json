{
  "name": "working-memory",
  "description": "Standalone Working Memory desktop app and control plane.",
  "version": "0.15.4",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mkubarycz/working-memory.git"
  },
  "homepage": "https://github.com/mkubarycz/working-memory#readme",
  "bugs": {
    "url": "https://github.com/mkubarycz/working-memory/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "tsc -p . && npm run compile:control-plane",
    "compile:control-plane": "tsc -p control-plane",
    "compile:desktop": "npm run build --prefix desktop-ui",
    "container:build": "docker compose build control-plane",
    "container:logs": "docker compose logs -f control-plane",
    "container:start": "docker compose up -d --build control-plane",
    "container:stop": "docker compose stop control-plane",
    "watch": "tsc -p . -w",
    "test": "vitest run",
    "test:standalone-template": "bash scripts/test-standalone-template.sh",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
