{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: compile",
      "type": "npm",
      "script": "compile",
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "npm: compile:control-plane",
      "type": "npm",
      "script": "compile:control-plane",
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "silent" }
    },
    {
      // Kill the stale DEV control-plane daemon by the pid recorded in the
      // sandbox port file (never by entry-path substring — the installed
      // production daemon shares the same out/control-plane/index.js suffix and
      // must NOT be touched), free the fixed sandbox port (7717) as a fallback,
      // then clear the lock/port runtime files. Always exits 0 so "nothing to
      // kill" never blocks the F5 launch.
      "label": "kill-stale-control-plane",
      "type": "shell",
      "command": "PF=\"$HOME/wm-control-plane-sandbox/run/control-plane.port.json\"; if [ -f \"$PF\" ]; then PID=$(sed -n 's/.*\"pid\"[[:space:]]*:[[:space:]]*\\([0-9][0-9]*\\).*/\\1/p' \"$PF\"); [ -n \"$PID\" ] && kill \"$PID\" 2>/dev/null; fi; lsof -ti tcp:7717 | xargs kill -9 2>/dev/null; rm -f \"$HOME/wm-control-plane-sandbox/run/control-plane.lock\" \"$PF\"; true",
      "presentation": { "reveal": "silent" },
      "problemMatcher": []
    },
    {
      // Composite prep for the control-plane F5: kill stale daemons first, then
      // compile. Used as the preLaunchTask so every F5 starts from a clean slate.
      "label": "prep-control-plane",
      "dependsOrder": "sequence",
      "dependsOn": ["kill-stale-control-plane", "npm: compile:control-plane"],
      "problemMatcher": []
    },
    {
      // Composite prep for the EXTENSION F5. The embedded daemon is a separate
      // OS process that orphans when the debugger is stopped abruptly (its
      // parent ext-host dies without a clean deactivate). A leftover daemon
      // holds port 7717 + the single-instance lock, so the next F5 connects to
      // the STALE daemon (with its un-reset sandbox) instead of spawning a fresh
      // one — surfacing leftover workstreams. Killing stale daemons before the
      // full compile guarantees each F5 spawns a fresh, sandbox-resetting daemon.
      "label": "prep-extension",
      "dependsOrder": "sequence",
      "dependsOn": ["kill-stale-control-plane", "npm: compile"],
      "problemMatcher": []
    }
  ]
}
