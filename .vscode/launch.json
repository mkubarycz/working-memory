{
  // Launch config for testing this extension in an Extension Development Host
  // window. F5 compiles the extension, spawns an isolated VS Code window with
  // only this extension loaded, and opens ~/wm-sandbox (a snapshot hub) as the
  // workspace so the extension finds the snapshot DB instead of the live one.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (sandbox hub)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--enable-proposed-api=kubarycz.working-memory",
        "${env:HOME}/wm-sandbox"
      ],
      "env": {
        "WM_CONTROL_PLANE_HOME": "${env:HOME}/wm-control-plane-sandbox",
        "WM_CONTROL_PLANE_HOSTING": "embedded"
      },
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "npm: compile"
    },
    {
      // Standalone control-plane daemon (WM 13.0 Phase 1). F5 compiles the
      // service, then runs it as a plain Node process bound to 127.0.0.1. It
      // uses a dedicated sandbox app-data home so it never touches the real
      // per-user store. Verify with:
      //   PORT=$(python3 -c "import json;print(json.load(open('$HOME/wm-control-plane-sandbox/run/control-plane.port.json'))['port'])")
      //   curl http://127.0.0.1:$PORT/health
      "name": "Run Control Plane Service",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/out/control-plane/index.js",
      "runtimeArgs": ["--experimental-sqlite"],
      "env": {
        "WM_CONTROL_PLANE_HOME": "${env:HOME}/wm-control-plane-sandbox"
      },
      "console": "integratedTerminal",
      "outFiles": [
        "${workspaceFolder}/out/control-plane/**/*.js"
      ],
      "skipFiles": ["<node_internals>/**"],
      "preLaunchTask": "prep-control-plane"
    }
  ],
  "compounds": [
    {
      "name": "Run WM 13.0 Sandbox (extension + control plane)",
      "configurations": ["Run Control Plane Service", "Run Extension (sandbox hub)"],
      "stopAll": true
    }
  ]
}
